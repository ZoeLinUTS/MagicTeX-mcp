{
  "name": "magictex-mcp",
  "mcpName": "io.github.ZoeLinUTS/magictex",
  "version": "0.1.2",
  "description": "MagicTeX — a LaTeX editor for AI agents (Claude Code), via an MCP server: live PDF preview, an editable source panel with a Visual (WYSIWYG) mode, anchored PDF comments that drive edits, and git-backed history. Compiles your .tex with a WASM TeX Live engine in a headless browser — no local TeX install, no Overleaf account.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "magictex",
    "latex",
    "tex",
    "texlive",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agent",
    "ai-agents",
    "llm",
    "overleaf",
    "latex-editor",
    "wysiwyg-editor",
    "pdf",
    "preview",
    "wasm",
    "academic-writing",
    "research-tools"
  ],
  "homepage": "https://github.com/ZoeLinUTS/MagicTeX-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoeLinUTS/MagicTeX-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ZoeLinUTS/MagicTeX-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "magictex-mcp": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "ui/dist/",
    "assets/fallback-styles/",
    "docs/",
    ".mcp.json.example",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "build:ui": "vite build ui",
    "dev:ui": "vite ui",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build:ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^4.0.0",
    "diff2html": "^3.4.56",
    "katex": "^0.16.47",
    "open": "^10.0.0",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.40.0",
    "texlyre-busytex": "^1.2.3",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.0.4",
    "codemirror-lang-latex": "^0.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "vite": "^8.1.5"
  }
}
